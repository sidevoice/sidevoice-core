{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreContractSlice",
  "type": "object",
  "required": [
    "languagesResponse",
    "trialRequest",
    "trialResponse",
    "trialRefusal",
    "voiceMediaCommand"
  ],
  "properties": {
    "languagesResponse": {
      "$ref": "#/$defs/LanguagesResponse"
    },
    "trialRequest": {
      "$ref": "#/$defs/TrialRequest"
    },
    "trialResponse": {
      "$ref": "#/$defs/TrialResponse"
    },
    "trialRefusal": {
      "$ref": "#/$defs/TrialRefusal"
    },
    "voiceMediaCommand": {
      "$ref": "#/$defs/VoiceMediaCommand"
    }
  },
  "$defs": {
    "LanguagesStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "model",
        "options",
        "build"
      ],
      "properties": {
        "place": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "build": {
          "type": "null"
        }
      }
    },
    "LanguagesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui_language",
        "stt",
        "tts",
        "audio_grace_seconds",
        "replay_on_return_seconds",
        "turn_patience",
        "turn_end_mode",
        "user_speech_timeout",
        "smart_turn_min_silence",
        "smart_turn_max_silence",
        "vad_confidence",
        "vad_min_volume",
        "vad_start_secs",
        "merge_window_secs"
      ],
      "properties": {
        "ui_language": {
          "type": "string"
        },
        "stt": {
          "$ref": "#/$defs/LanguagesStage"
        },
        "tts": {
          "$ref": "#/$defs/LanguagesStage"
        },
        "audio_grace_seconds": {
          "type": "number"
        },
        "replay_on_return_seconds": {
          "type": "integer"
        },
        "turn_patience": {
          "type": "string"
        },
        "turn_end_mode": {
          "type": "string"
        },
        "user_speech_timeout": {
          "type": "number"
        },
        "smart_turn_min_silence": {
          "type": "number"
        },
        "smart_turn_max_silence": {
          "type": "number"
        },
        "vad_confidence": {
          "type": "number"
        },
        "vad_min_volume": {
          "type": "number"
        },
        "vad_start_secs": {
          "type": "number"
        },
        "merge_window_secs": {
          "type": "number"
        }
      }
    },
    "TrialRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "model",
        "audio"
      ],
      "properties": {
        "place": {
          "type": "string",
          "enum": [
            "openai"
          ]
        },
        "model": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/TrialOptions"
        },
        "audio": {
          "$ref": "#/$defs/TrialAudio"
        }
      }
    },
    "TrialOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      }
    },
    "TrialAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "sample_rate",
        "data_base64"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": [
            "pcm_s16le"
          ]
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            16000
          ]
        },
        "data_base64": {
          "type": "string"
        }
      }
    },
    "TrialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "TrialRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail"
      ],
      "properties": {
        "detail": {
          "$ref": "#/$defs/RefusalDetail"
        }
      }
    },
    "RefusalDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "message"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "VoiceMediaCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "voice-media"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "path"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "enum": [
                "socket",
                "webrtc"
              ]
            }
          }
        }
      }
    }
  }
}
